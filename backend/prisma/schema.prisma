generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ACCOUNTANT
  ADMIN
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ClientType {
  PERSON
  COMPANY
}

enum FormType {
  GPD
  SPR
  ZO3
  UGOVOR
}

enum FormStatus {
  DRAFT
  GENERATED
  SUBMITTED
  ARCHIVED
}

enum OrganizationType {
  COMPANY
  BUSINESS // obrt
}

model User {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  googleId     String?   @unique 
  email        String?   @unique @db.VarChar(255)
  jmbg         String?   @unique @db.VarChar(255)
  password     String?   @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  address      String?   @db.VarChar(255)
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizations OrganizationMember[]
  createdOrganizations Organization[] @relation("OrganizationCreatedBy")

  createdForms Form[] @relation("FormCreatedBy")
  updatedForms Form[] @relation("FormUpdatedBy")
  createdClients Client[] @relation("ClientCreatedBy")

  @@map("users")
}

model Organization {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(255)
  type          OrganizationType @default(COMPANY)
  taxNumber     String?  @unique @db.VarChar(100)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.VarChar(255)

  ownerId Int? @unique @db.UnsignedInt
  owner   OrganizationOwner? @relation("OrgOwner", fields: [ownerId], references: [id])

  createdById Int @db.UnsignedInt
  createdBy   User @relation("OrganizationCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       OrganizationMember[]
  clients       Client[]
  forms         Form[]

  @@map("organizations")
}

model OrganizationMember {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  organizationId  Int               @db.UnsignedInt
  userId          Int               @db.UnsignedInt
  role            OrganizationRole  @default(MEMBER)
  joinedAt        DateTime          @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id])
  user            User              @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model OrganizationOwner {
  id        Int @id @default(autoincrement()) @db.UnsignedInt

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  jmbg      String @unique @db.VarChar(255)

  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(50)
  address   String? @db.VarChar(255)

  createdAt DateTime @default(now())

  organization Organization? @relation("OrgOwner")
}

model Client {
  id               Int         @id @default(autoincrement()) @db.UnsignedInt
  organizationId   Int?        @db.UnsignedInt

  type             ClientType  @default(PERSON)

  firstName        String?     @db.VarChar(100)
  lastName         String?     @db.VarChar(100)
  companyName      String?     @db.VarChar(255)

  email            String?     @db.VarChar(255)
  phone            String?     @db.VarChar(50)
  address          String?     @db.VarChar(255)

  jmbg             String?     @db.VarChar(500)
  taxNumber        String?     @db.VarChar(100)

  createdById      Int?        @db.UnsignedInt
  createdBy        User?       @relation("ClientCreatedBy", fields: [createdById], references: [id])

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization     Organization? @relation(fields: [organizationId], references: [id])
  forms            Form[]

  @@map("clients")
}

model Form {
  id                Int         @id @default(autoincrement()) @db.UnsignedInt
  type              FormType
  status            FormStatus  @default(DRAFT)

  year              Int
  month             Int?
  title             String?     @db.VarChar(255)

  organizationId    Int?        @db.UnsignedInt
  clientId          Int?        @db.UnsignedInt

  createdById       Int         @db.UnsignedInt
  updatedById       Int?        @db.UnsignedInt

  pdfUrl            String?     @db.VarChar(500)
  notes             String?     @db.Text

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization      Organization? @relation(fields: [organizationId], references: [id])
  client            Client?       @relation(fields: [clientId], references: [id])

  createdBy         User          @relation("FormCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?         @relation("FormUpdatedBy", fields: [updatedById], references: [id])

versions          FormVersion[]
  attachments       FormAttachment[]

  @@index([type, year])
  @@index([organizationId])
  @@index([clientId])
  @@map("forms")
}

model FormVersion {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  formId         Int      @db.UnsignedInt
  versionNumber  Int

  data           Json
  pdfUrl         String?  @db.VarChar(500)

  createdAt      DateTime @default(now())

  form           Form     @relation(fields: [formId], references: [id])

  @@unique([formId, versionNumber])
  @@map("form_versions")
}

model FormAttachment {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  formId      Int      @db.UnsignedInt

  fileName    String   @db.VarChar(255)
  fileUrl     String   @db.VarChar(500)
  mimeType    String?  @db.VarChar(100)

  createdAt   DateTime @default(now())

  form        Form     @relation(fields: [formId], references: [id])

  @@map("form_attachments")
}