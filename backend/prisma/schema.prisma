generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                  @id @default(autoincrement()) @db.UnsignedInt
  googleId                 String?              @unique
  email                    String?              @unique @db.VarChar(255)
  password                 String?              @db.VarChar(255)
  firstName                String               @db.VarChar(100)
  lastName                 String               @db.VarChar(100)
  phone                    String?              @db.VarChar(30)
  address                  String?              @db.VarChar(255)
  role                     users_role           @default(USER)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  jmbg                     String?              @unique @db.VarChar(255)
  passwordResetToken       String?              @db.VarChar(255)
  passwordResetTokenExpiry DateTime?
  emailVerificationExpiry  DateTime?
  emailVerificationToken   String?              @db.VarChar(255)
  isEmailVerified          Boolean              @default(false)
  idCardNumber             String?              @db.VarChar(9)
  createdClients           Client[]             @relation("ClientCreatedBy")
  createdForms             Form[]               @relation("FormCreatedBy")
  updatedForms             Form[]               @relation("FormUpdatedBy")
  organizations            OrganizationMember[]
  createdOrganizations     Organization[]       @relation("OrganizationCreatedBy")
  subscription             Subscription?

  @@map("users")
}

model Subscription {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    Int      @unique @db.UnsignedInt
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Organization {
  id           Int                  @id @default(autoincrement()) @db.UnsignedInt
  name         String               @db.VarChar(255)
  taxNumber    String?              @unique @db.VarChar(100)
  email        String?              @db.VarChar(255)
  phone        String?              @db.VarChar(50)
  address      String?              @db.VarChar(255)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdById  Int                  @db.UnsignedInt
  type         OrganizationType     @default(COMPANY)
  activityCode String?              @db.VarChar(20)
  activityName String?              @db.VarChar(255)
  isClientOrg  Boolean              @default(false)
  clients      Client[]
  forms        Form[]
  members      OrganizationMember[]
  createdBy    User                 @relation("OrganizationCreatedBy", fields: [createdById], references: [id])
  workers      Worker[]

  @@index([createdById], map: "organizations_createdById_fkey")
  @@map("organizations")
}

model Worker {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  organizationId Int          @db.UnsignedInt
  firstName      String       @db.VarChar(100)
  lastName       String       @db.VarChar(100)
  jmbg           String?      @db.VarChar(500)
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  address        String?      @db.VarChar(255)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(50)
  role           WorkerRole   @default(RADNIK)
  idCardNumber   String?      @db.VarChar(9)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("workers")
}

model OrganizationMember {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  organizationId Int              @db.UnsignedInt
  userId         Int              @db.UnsignedInt
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId], map: "organization_members_userId_fkey")
  @@map("organization_members")
}

model Client {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  organizationId   Int?          @db.UnsignedInt
  type             ClientType    @default(PERSON)
  firstName        String?       @db.VarChar(100)
  lastName         String?       @db.VarChar(100)
  companyName      String?       @db.VarChar(255)
  email            String?       @db.VarChar(255)
  phone            String?       @db.VarChar(50)
  address          String?       @db.VarChar(255)
  jmbg             String?       @db.VarChar(500)
  taxNumber        String?       @db.VarChar(100)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      Int?          @db.UnsignedInt
  amortizacijaOnly Boolean       @default(false)
  idCardNumber     String?       @db.VarChar(9)
  createdBy        User?         @relation("ClientCreatedBy", fields: [createdById], references: [id])
  organization     Organization? @relation(fields: [organizationId], references: [id])
  forms            Form[]

  @@index([createdById], map: "clients_createdById_fkey")
  @@index([organizationId], map: "clients_organizationId_fkey")
  @@map("clients")
}

model Form {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  type           forms_type
  status         FormStatus       @default(DRAFT)
  year           Int
  month          Int?
  title          String?          @db.VarChar(255)
  organizationId Int?             @db.UnsignedInt
  clientId       Int?             @db.UnsignedInt
  createdById    Int              @db.UnsignedInt
  updatedById    Int?             @db.UnsignedInt
  pdfUrl         String?          @db.VarChar(500)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  attachments    FormAttachment[]
  versions       FormVersion[]
  client         Client?          @relation(fields: [clientId], references: [id])
  createdBy      User             @relation("FormCreatedBy", fields: [createdById], references: [id])
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  updatedBy      User?            @relation("FormUpdatedBy", fields: [updatedById], references: [id])

  @@index([type, year])
  @@index([organizationId])
  @@index([clientId])
  @@index([createdById], map: "forms_createdById_fkey")
  @@index([updatedById], map: "forms_updatedById_fkey")
  @@map("forms")
}

model FormVersion {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  formId        Int      @db.UnsignedInt
  versionNumber Int
  data          String   @db.LongText
  pdfUrl        String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  form          Form     @relation(fields: [formId], references: [id])

  @@unique([formId, versionNumber])
  @@map("form_versions")
}

model FormAttachment {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  formId    Int      @db.UnsignedInt
  fileName  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(500)
  mimeType  String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id])

  @@index([formId], map: "form_attachments_formId_fkey")
  @@map("form_attachments")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ClientType {
  PERSON
  COMPANY
}

enum FormStatus {
  DRAFT
  GENERATED
  SUBMITTED
  ARCHIVED
}

enum OrganizationType {
  COMPANY
  BUSINESS
}

enum WorkerRole {
  VLASNIK
  RADNIK
}

enum forms_type {
  GPD
  SPR
  ZO3
  UGOVOR
  PLDI
  AMS
}

enum users_role {
  USER
  PRO
  BUSINESS
  ADMIN
}
